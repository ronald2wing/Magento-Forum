<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
  <head>
    <css src="Ronald2Wing_Forum/css/forum.css"/>
    <link src="Ronald2Wing_Forum/tinymce/tinymce.min.js"/>
  </head>
  <body>
    <referenceBlock name="breadcrumbs">
      <action method="addCrumb">
        <argument name="crumbName" xsi:type="string">Home</argument>
        <argument name="crumbInfo" xsi:type="array">
          <item name="title" xsi:type="string">Home</item>
          <item name="label" xsi:type="string">Home</item>
          <item name="link" xsi:type="string">/</item>
        </argument>
      </action>
    </referenceBlock>
    <referenceContainer name="content">
      <block cacheable="false" class="Magento\Framework\View\Element\Template" name="forum.edit" template="Ronald2Wing_Forum::topic/edit.phtml">
        <arguments>
          <argument name="view_model" xsi:type="object">Ronald2Wing\Forum\ViewModel\Topic\Edit</argument>
          <argument name="forum_data" xsi:type="object">Ronald2Wing\Forum\Helper\Data</argument>
        </arguments>
        <block class="Magento\Framework\View\Element\Template" name="forum.edit.form" template="Ronald2Wing_Forum::topic/edit/form.phtml">
          <arguments>
            <argument name="view_model" xsi:type="object">Ronald2Wing\Forum\ViewModel\Topic\EditForm</argument>
            <argument name="forum_data" xsi:type="object">Ronald2Wing\Forum\Helper\Data</argument>
          </arguments>
          <block class="Magento\Framework\View\Element\Template" name="forum.edit.form.icons" template="Ronald2Wing_Forum::topic/edit/form/icons.phtml">
            <arguments>
              <argument name="view_model" xsi:type="object">Ronald2Wing\Forum\ViewModel\Topic\EditFormIcons</argument>
              <argument name="forum_data" xsi:type="object">Ronald2Wing\Forum\Helper\Data</argument>
            </arguments>
          </block>
          <block class="Magento\Framework\View\Element\Template" name="forum.edit.editor" template="Ronald2Wing_Forum::editor/init.phtml" />
        </block>
      </block>
    </referenceContainer>
  </body>
</page>
