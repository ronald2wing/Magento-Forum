<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <head>
        <title translate="true">My Forum Subscriptions</title>
        <css src="Ronald2Wing_Forum/css/forum.css"/>
    </head>
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument translate="true" name="title" xsi:type="string">My Forum Subscriptions</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block cacheable="false" class="Magento\Framework\View\Element\Template" name="forum.customer.subscriptions" template="Ronald2Wing_Forum::customer/subscriptions.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Ronald2Wing\Forum\ViewModel\Customer\Subscriptions</argument>
                    <argument name="forum_data" xsi:type="object">Ronald2Wing\Forum\Helper\Data</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
