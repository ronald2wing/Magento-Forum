<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
  <head>
    <css src="Ronald2Wing_Forum/css/forum.css"/>
    <link src="Ronald2Wing_Forum/js/forum.js"/>
  </head>
  <body>
    <referenceBlock name="breadcrumbs">
      <action method="addCrumb">
        <argument name="crumbName" xsi:type="string">Home</argument>
        <argument name="crumbInfo" xsi:type="array">
          <item name="title" translate="true" xsi:type="string">Home</item>
          <item name="label" translate="true" xsi:type="string">Home</item>
          <item name="link" xsi:type="string">/</item>
        </argument>
      </action>
    </referenceBlock>
    <referenceContainer name="content">
      <block cacheable="false" class="Magento\Framework\View\Element\Template" name="forum.view.index" template="Ronald2Wing_Forum::forum/index.phtml">
        <arguments>
          <argument name="view_model" xsi:type="object">Ronald2Wing\Forum\ViewModel\Forum\View</argument>
          <argument name="forum_data" xsi:type="object">Ronald2Wing\Forum\Helper\Data</argument>
        </arguments>
        <block class="Magento\Framework\View\Element\Template" name="forum.index.top" template="Ronald2Wing_Forum::forum/top/block.phtml">
          <arguments>
            <argument name="view_model" xsi:type="object">Ronald2Wing\Forum\ViewModel\Forum\TopBlock</argument>
            <argument name="forum_data" xsi:type="object">Ronald2Wing\Forum\Helper\Data</argument>
          </arguments>
          <block class="Magento\Framework\View\Element\Template" name="forum.ui.search" template="Ronald2Wing_Forum::ui/form_search.phtml">
                        <arguments>
                            <argument name="view_model" xsi:type="object">Ronald2Wing\Forum\ViewModel\Ui\FormSearch</argument>
                            <argument name="forum_data" xsi:type="object">Ronald2Wing\Forum\Helper\Data</argument>
                        </arguments>
          </block>
          <block class="Magento\Framework\View\Element\Template" name="forum.ui.bookmarks" template="Ronald2Wing_Forum::ui/bookmarks.phtml">
                        <arguments>
                            <argument name="view_model" xsi:type="object">Ronald2Wing\Forum\ViewModel\Ui\Bookmarks</argument>
                            <argument name="forum_data" xsi:type="object">Ronald2Wing\Forum\Helper\Data</argument>
                        </arguments>
          </block>
          <block class="Magento\Framework\View\Element\Template" name="forum.ui.jumpto" template="Ronald2Wing_Forum::ui/jumpto.phtml">
                        <arguments>
                            <argument name="view_model" xsi:type="object">Ronald2Wing\Forum\ViewModel\Ui\JumpTo</argument>
                            <argument name="forum_data" xsi:type="object">Ronald2Wing\Forum\Helper\Data</argument>
                        </arguments>
          </block>
          <block class="Magento\Framework\View\Element\Template" name="forum.ui.rss" template="Ronald2Wing_Forum::ui/rss.phtml">
                        <arguments>
                            <argument name="view_model" xsi:type="object">Ronald2Wing\Forum\ViewModel\Ui\Rss</argument>
                            <argument name="forum_data" xsi:type="object">Ronald2Wing\Forum\Helper\Data</argument>
                        </arguments>
          </block>
        </block>
        <block class="Magento\Framework\View\Element\Template" name="forum.index.list" template="Ronald2Wing_Forum::forum/view/list.phtml">
          <arguments>
            <argument name="view_model" xsi:type="object">Ronald2Wing\Forum\ViewModel\Forum\ListTopic</argument>
            <argument name="forum_data" xsi:type="object">Ronald2Wing\Forum\Helper\Data</argument>
          </arguments>
        </block>
        <block class="Magento\Framework\View\Element\Template" name="forum.index.bottom" template="Ronald2Wing_Forum::forum/bottom/block.phtml">
          <arguments>
            <argument name="view_model" xsi:type="object">Ronald2Wing\Forum\ViewModel\Forum\TopBlock</argument>
            <argument name="forum_data" xsi:type="object">Ronald2Wing\Forum\Helper\Data</argument>
          </arguments>
          <block class="Magento\Framework\View\Element\Template" name="forum.ui.jumpto.bottom" template="Ronald2Wing_Forum::ui/jumpto.phtml">
          </block>
          <block class="Magento\Framework\View\Element\Template" name="forum.ui.whoisonline.bottom" template="Ronald2Wing_Forum::ui/who_is_online/forum_view.phtml">
          </block>
        </block>
      </block>
    </referenceContainer>
  </body>
</page>
