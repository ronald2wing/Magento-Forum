                                    <img src="<?= $block->escapeUrl($block->getViewFileUrl('Ronald2Wing_Forum' . DIRECTORY_SEPARATOR . 'images' . DIRECTORY_SEPARATOR . 'clock_icon.png')) ?>" alt="" />
                                    <?= $block->escapeHtml(__('Added: %1', $block->getViewModel()->getTimeAccordingToTimeZone($_topic->getCreatedAt()))) ?>
