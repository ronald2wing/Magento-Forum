                                        <?= $block->escapeHtml($parentForum->getTitle()) ?>
                                    </a>
                                </div>
                            </td>
                            <td>
                                <div class="forum-myaccount-topic">
                                    <img src="<?= $block->escapeUrl($block->getViewFileUrl('Ronald2Wing_Forum' . DIRECTORY_SEPARATOR . 'images' . DIRECTORY_SEPARATOR . 'folder_topic.png')) ?>" alt="" />
                                    <a href="<?= $block->escapeUrl($block->getViewModel()->getTopicUrl($parentForum, $_topic)) ?>">
                                        <?= $block->escapeHtml($_topic->getTitle()) ?>
