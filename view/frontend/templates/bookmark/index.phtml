                                    <div class="forum-created-time">
                                        <?= $block->escapeHtml(__('Created')) ?>: <?= $block->escapeHtml($block->getViewModel()->getTimeAccordingToTimeZone($item->getParentForum()->getCreatedAt())) ?>
                                    </div>
                                </div>
