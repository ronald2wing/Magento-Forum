    <div class="forum-top-block">
        <?= $block->getChildHtml('forum.index.top') ?>
    </div>
    <div class="forum-content-container forum-content-bookmark-container">
        <div class="forum-list-container clearfix">
            <h3 class="grid-title">
                <?= $block->escapeHtml(__('My Bookmarks')) ?>
            </h3>
        </div>

