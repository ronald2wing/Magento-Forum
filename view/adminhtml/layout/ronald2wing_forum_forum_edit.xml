<?xml version="1.0"?>

<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="admin-2columns-left" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    
  <body>
    <!-- update handle="editor"/ -->
    <referenceContainer name="content">
      <block class="Ronald2Wing\Forum\Block\Adminhtml\Forum\Edit" name="forum_forum_edit"/>
    </referenceContainer>
    <referenceContainer name="left">
      <block class="Ronald2Wing\Forum\Block\Adminhtml\Forum\Edit\Tabs" name="forum_forum_edit_tabs">
        <block class="Ronald2Wing\Forum\Block\Adminhtml\Forum\Edit\Tab\Main" name="forum_forum_edit_tab_main"/>
        <block class="Ronald2Wing\Forum\Block\Adminhtml\Forum\Edit\Tab\MetaData" name="forum_forum_edit_tab_meta_data"/>
        <block class="Ronald2Wing\Forum\Block\Adminhtml\Forum\Edit\Tab\Icon" name="forum_forum_edit_tab_icon" template="forum/icons.phtml" />
        <action method="addTab">
          <argument name="name" xsi:type="string">main_section</argument>
          <argument name="block" xsi:type="string">forum_forum_edit_tab_main</argument>
        </action>
        <action method="addTab">
          <argument name="name" xsi:type="string">meta_data</argument>
          <argument name="block" xsi:type="string">forum_forum_edit_tab_meta_data</argument>
        </action>
        <action method="addTab">
          <argument name="name" xsi:type="string">icons</argument>
          <argument name="block" xsi:type="string">forum_forum_edit_tab_icon</argument>
        </action>
      </block>
    </referenceContainer>
  </body>
</page>
