{
  "name": "ronald2wing/module-forum",
  "description": "Magento 2 forum extension with hierarchical forums, topics, posts, moderation queue, post reporting, email notifications, GraphQL and REST API",
  "type": "magento2-module",
  "license": "MIT",
  "keywords": [
    "magento2",
    "forum",
    "discussion-board",
    "community",
    "moderation"
  ],
  "homepage": "https://github.com/ronald2wing/module-forum",
  "require": {
    "php": ">=8.1",
    "magento/framework": ">=103.0",
    "magento/module-store": ">=101.0",
    "magento/module-backend": ">=102.0",
    "magento/module-ui": ">=101.0",
    "magento/module-customer": ">=103.0",
    "magento/module-theme": ">=101.0",
    "magento/module-webapi": ">=100.4",
    "magento/module-graph-ql": ">=100.4"
  },
  "require-dev": {
    "phpunit/phpunit": ">=9.5",
    "magento/magento-coding-standard": "*"
  },
  "suggest": {
    "magento/module-csp": "Content Security Policy for rich HTML posts",
    "magento/module-elasticsearch": "Replace database LIKE search with full-text indexing"
  },
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Ronald2Wing\\Forum\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ronald2Wing\\Forum\\Test\\": "Test/"
    }
  },
  "authors": [
    {
      "name": "Ronald2Wing"
    }
  ],
  "support": {
    "source": "https://github.com/ronald2wing/module-forum",
    "issues": "https://github.com/ronald2wing/module-forum/issues"
  }
}
